# War of Poker — environment variables
#
# Copy to `.env.local` for development. Never commit a filled-in copy: `.env*`
# is gitignored and must stay that way.
#
# The application builds and runs with none of these set. Each missing variable
# disables one capability rather than breaking a page, so you can bring the
# funnel up a piece at a time.

# --- Supabase -------------------------------------------------------------
# Project Settings → API. The service-role key bypasses Row Level Security and
# must never be exposed to the browser or committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---------------------------------------------------------------
# Use test keys (sk_test_…) in development.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or from
# the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Resend ---------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sending domain, e.g. "River Potter <river@warofpoker.com>".
EMAIL_FROM=

# --- Application secrets --------------------------------------------------
# Signs purchasers' download links. Rotating it invalidates every outstanding
# link. Generate with: openssl rand -base64 48
DELIVERY_SECRET=

# Bearer token for /growth and the /api/content and /api/email/dispatch routes.
# Generate with: openssl rand -base64 32
GROWTH_DASHBOARD_TOKEN=

# --- Site origin ----------------------------------------------------------
# Defaults to https://warofpoker.com, which is correct for production -- leave
# this unset there. Set it on any OTHER host (staging, a preview, a subdomain
# rehearsal) so Stripe redirects, email links, canonical tags, and the sitemap
# point at that host instead of production. On Vercel it is detected
# automatically and you do not need to set anything.
# NEXT_PUBLIC_SITE_URL=https://staging.example.com

# --- Optional -------------------------------------------------------------
# The quiz-completer price, in cents. Defaults to 3900 ($39) when unset.
# NEXT_PUBLIC_ prefixed because the pricing UI renders it.
NEXT_PUBLIC_QUIZ_OFFER_CENTS=3900
